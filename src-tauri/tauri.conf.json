{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutie Desktop Pet",
  "version": "0.1.0",
  "identifier": "com.present0206.cutie-univ-stu-pojjak",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cutie Desktop Pet",
        "width": 320,
        "height": 320,
        "minWidth": 320,
        "minHeight": 320,
        "maxWidth": 320,
        "maxHeight": 320,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "preventOverflow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
